{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://PARTYVERSE-BACKEND.up.railway.app/api/:path*" },
    { "source": "/share/:path*", "destination": "https://PARTYVERSE-BACKEND.up.railway.app/share/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://PARTYVERSE-BACKEND.up.railway.app/socket.io/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
